---
import Hello from "./Hello.astro";
import MyName from "./MyName.astro";

const skills = [
  "Architectural software design",
  "Frontend and UX/UI development",
  "Backend and Platform Development",
  "Cybersecurity",
  "Machine Learning",
  "FinTech",
  "Data Science",
];

const interests = [
  "playing instruments 🎸",
  "skateboarding 🛹",
  "training my body & eating healthy",
  "and going to festivals 🏟️",
];
---

<Hello name="Visitor" />
<br />
<p>My name is <MyName gap="0.2rem" />. I am a Software Engineer based in <strong>Zürich, Switzerland</strong> (GMT+2) 📍🇨🇭 </p>
<br />
<p>I have professional experience and degrees in {skills.map((skill, i) => {
  const isLast = i === skills.length - 1;
  const isSecondLast = i === skills.length - 2;
  if (isLast) {
    return <span>and <strong>{skill}</strong></span>
  } else if (isSecondLast) {
    return <span><strong>{skill}</strong> </span>;
  } else {
    return <span><strong>{skill}</strong>, </span>;
  }
})}.
</p>
<br />
<p>In my civil life, my passions include {interests.join(', ')}.</p>
