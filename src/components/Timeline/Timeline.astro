---
import type { TimelineEntryProps, TimelineOrder } from "./TimelineEntry.astro";
import TimelineEntry from "./TimelineEntry.astro";

interface Props {
  entries?: TimelineEntryProps[] | undefined;
  order?: TimelineOrder;
}

const { entries, order = "desc" } = Astro.props;
const orderedEntries = order === "asc" ? [...(entries ?? [])].reverse() : entries ?? [];
---

<div class="timeline">
  {orderedEntries.map((entry) => (
    <TimelineEntry {...entry} order={order} />
  ))}
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
  }
</style>
