---
import SubPageHero from "@components/SubPageHero.astro";
import Layout from "@layouts/Layout.astro";
import { pages } from "@data/pageData";
import Flex from "@components/layout/Flex.astro";
import MyName from "@components/MyName.astro";

const page = pages.find((page) => page.key === "about");
---

<Layout title={page?.title || ''}>
  <SubPageHero {...page} />
  <br />
  <!-- <div class="placeholder">{makeLorem(100)}</div> -->
  <Flex>
    <img src="/images/aboutme/headshot.jpeg" alt="headshot" class="headshot" />
    <p>
      My name is <MyName gap="0.2rem" />.
      <br />
      <br />
      I'm a seasoned full-stack software engineer from Budapest, Hungary 🇭🇺 with experience in distributed systems, cybersecurity, platform- and UI development. I hold a Master's in Computer Science from Eötvös Loránd University, where I specialized in Software Architectures and FinTech (Financial Technologies).
      <br />
      <br />
      I'm an optimist, a lifelong learner and a problem solver. I question the status quo, mostly in a polite way.
      <br />
      <br />
      Outside work, I run a small fleet of Raspberry Pis that host my own VPN server, AirPlay receiver and other solutions I needed in the past years. It's all containerized, because why not. When I'm not doing that, I play guitar or read about psychology, leadership and self-improvement.
    </p>
  </Flex>
</Layout>

<style>
  .headshot {
    width: 40%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0px 6px 15px rgba(153, 153, 153, 0.5);
  }

  :global(html[data-theme='dark']) .headshot {
    box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.6);
  }

  p {
    text-align: left;
  }

  .placeholder {
    color: var(--text-color-secondary);
    border-radius: 8px;
    min-height: 50vh;
  }

  a.contact-link {
    color: var(--primary-color);
  }
</style>