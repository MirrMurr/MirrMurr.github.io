---
import SubPageHero from "@components/SubPageHero.astro";
import Layout from "@layouts/Layout.astro";
import { pages } from "@data/pageData";
import AchievementCard from "@components/AchievementCard.astro";
import { achievements } from "@data/achievements";

const page = pages.find((page) => page.key === "achievements");
---

<Layout title={page?.title || ""}>
  <SubPageHero {...page} />
  <br />
  <div class="achievements">
    {achievements.map((achievement) => <AchievementCard achievement={achievement} />)}
  </div>
</Layout>

<style>
  .achievements {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
